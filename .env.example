# Скопируй в .env. Файл читает Node.js; он никогда не выполняется как shell.
# Значения с пробелами, # или $ заключай в одинарные кавычки.
# Внутри кавычек $ и $(...) остаются обычным текстом.
BOT_TOKEN='PASTE_BOTFATHER_TOKEN'
GITHUB_OWNER='YOUR_GITHUB_USERNAME'
GITHUB_REPO='kinpass-mini-app'
# Fine-grained PAT: только выбранный репозиторий, Contents/Pages/Administration: Read and write.
GITHUB_TOKEN='PASTE_GITHUB_PAT'
SUPABASE_ACCESS_TOKEN='PASTE_SUPABASE_ACCESS_TOKEN'
SUPABASE_PROJECT_REF='PASTE_20_LETTER_PROJECT_REF'
SUPABASE_DB_PASSWORD='PASTE_DATABASE_PASSWORD'

# Обычно оставь закомментированным: URL определяется по PROJECT_REF.
# SUPABASE_URL='https://abcdefghijklmnopqrst.supabase.co'
# MINI_APP_BUTTON_TEXT='Открыть Kinpass'
# PAGES_WAIT_SECONDS=600
